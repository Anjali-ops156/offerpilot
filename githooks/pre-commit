#!/usr/bin/env python
"""Blocks commits that contain likely secrets (API keys, tokens, private keys).

Installed into .git/hooks/pre-commit by scripts/install_hooks.py.
Checks the staged diff only, not the whole tree, so it stays fast.
"""
import re
import subprocess
import sys

PATTERNS = [
    (r"sk-ant-[A-Za-z0-9_-]{20,}", "Anthropic API key"),
    (r"sk-[A-Za-z0-9]{20,}", "OpenAI-style API key"),
    (r"\b\d{8,10}:[A-Za-z0-9_-]{35}\b", "Telegram bot token"),
    (r"AKIA[0-9A-Z]{16}", "AWS access key ID"),
    (r"-----BEGIN [A-Z ]*PRIVATE KEY-----", "Private key block"),
    (r"(?i)(password|passwd|secret|token|api_key)\s*=\s*['\"][^'\"\s]{8,}['\"]", "Hardcoded credential assignment"),
]

ALLOWED_FILES = {".env.example", "githooks/pre-commit"}


def staged_diff() -> str:
    result = subprocess.run(
        ["git", "diff", "--cached", "-U0", "--no-color"],
        capture_output=True, text=True, encoding="utf-8", errors="replace",
    )
    return result.stdout or ""


def staged_files() -> list[str]:
    result = subprocess.run(
        ["git", "diff", "--cached", "--name-only"],
        capture_output=True, text=True, encoding="utf-8", errors="replace",
    )
    return [f.strip() for f in (result.stdout or "").splitlines() if f.strip()]


def main() -> int:
    files = set(staged_files())
    if ".env" in files:
        print("BLOCKED: .env is staged for commit. It must never be committed.")
        return 1

    diff = staged_diff()

    hits = []
    current_file = None
    for line in diff.splitlines():
        if line.startswith("+++ b/"):
            current_file = line[6:]
            continue
        if not line.startswith("+") or line.startswith("+++"):
            continue
        if current_file in ALLOWED_FILES:
            continue
        for pattern, label in PATTERNS:
            if re.search(pattern, line):
                hits.append((current_file, label, line.strip()[:100]))

    if hits:
        print("BLOCKED: possible secret(s) found in staged changes:\n")
        for fname, label, snippet in hits:
            print(f"  [{label}] {fname}: {snippet}")
        print("\nRemove the secret, use .env (gitignored) instead, and re-commit.")
        return 1

    return 0


if __name__ == "__main__":
    sys.exit(main())
